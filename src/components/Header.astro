---
import { Mail, Linkedin, Github } from 'lucide-react';

const careerStartDate = new Date('2022-04-11');
const today = new Date();
const yearsExperience = Math.floor((today - careerStartDate) / (1000 * 60 * 60 * 24 * 365.25));
---

<header class="border-b-2 border-stone-900 bg-amber-50">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="space-y-4">
      <h1 class="text-5xl font-bold tracking-tight">Hayden T. Brown</h1>
      <p class="text-2xl text-stone-700">Data Engineer</p>
      <p class="text-lg text-stone-600 max-w-2xl">
        Building production ETL pipelines and data infrastructure. {yearsExperience}+ years in the field. 
        <br>I make reliable systems so we can get to the fun stuff. ☺︎<br><br>Currently working at NY's largest labor union and pursuing OMSCS at Georgia Tech. 
      </p>
      <div class="flex gap-6 pt-4">
        <a href="&#109;&#97;&#105;&#108;to&#58;me&#64;hay%64&#101;nbr&#37;6Fw&#37;6E&#46;dev" class="flex items-center gap-2 text-stone-700 hover:text-stone-900 transition-colors">
          <Mail size={20} />
          <span class="text-sm font-mono">Email</span>
        </a>
        <a href="https://linkedin.com/in/hayden-t-brown" class="flex items-center gap-2 text-stone-700 hover:text-stone-900 transition-colors">
          <Linkedin size={20} />
          <span class="text-sm font-mono">LinkedIn</span>
        </a>
        <a href="https://github.com/hb-robo" class="flex items-center gap-2 text-stone-700 hover:text-stone-900 transition-colors">
          <Github size={20} />
          <span class="text-sm font-mono">GitHub</span>
        </a>
      </div>
    </div>
  </div>
</header>
