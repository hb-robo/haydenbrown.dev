---
import { ExternalLink } from 'lucide-react';

interface Props {
  title: string;
  status: 'production' | 'in-progress' | 'planned';
  tags: string[];
  description: string;
  link?: string;
}

const { title, status, tags, description, link } = Astro.props;

const statusStyles = {
  production: 'border-green-700 text-green-700 bg-green-50',
  'in-progress': 'border-amber-700 text-amber-700 bg-amber-50',
  planned: 'border-stone-400 text-stone-600 bg-stone-50'
};
---

<div class="border-2 border-stone-900 bg-white p-6">
  <div class="flex items-start justify-between mb-3">
    <div>
      <h3 class="text-xl font-bold">{title}</h3>
      <span class={`inline-block mt-2 px-3 py-1 text-xs font-mono border ${statusStyles[status]}`}>
        {status}
      </span>
    </div>
    {link && (
      <a href={link} class="text-stone-700 hover:text-stone-900 transition-colors">
        <ExternalLink size={20} />
      </a>
    )}
  </div>
  <p class="text-stone-700 mb-4">{description}</p>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="px-3 py-1 text-xs font-mono bg-stone-100 text-stone-700 border border-stone-300">
        {tag}
      </span>
    ))}
  </div>
</div>