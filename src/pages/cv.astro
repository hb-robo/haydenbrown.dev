---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ProjectFilter from '../components/ProjectFilter';
import { getCollection } from 'astro:content';

const careerStartDate = new Date('2022-04-11');
const yearsExperience = Math.floor((Date.now() - careerStartDate.getTime()) / (1000 * 60 * 60 * 24 * 365.25));

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);

const experience = [
  {
    title: "senior data analyst/engineer",
    org: "csea local 1000",
    period: "sep 2024 – present",
    location: "albany, ny",
    highlights: [
      "Own Python ETL pipeline standardizing files from 1,400+ government agencies, surfacing 30,000+ previously unreported union-eligible workers for targeted organizing",
      "Manage AWS infrastructure supporting 160,000+ member records, serving as internal point of contact for cloud operations and vendor coordination",
      "Architect production Salesforce schema to replace legacy UnionWare system, defining entity relationships for operational workloads",
      "Lead migration of 25+ years of legacy cron jobs into an observable, centralized Dagster DAG cascade"
    ]
  },
  {
    title: "data analyst",
    org: "csea local 1000",
    period: "apr 2022 – sep 2024",
    location: "albany, ny",
    highlights: [
      "Built and maintained 30+ live SplashBI dashboards powering outreach campaigns for a union steering committee representing 200,000+ workers",
      "Led security overhaul of legacy Node.js application, refactoring 300+ PostgreSQL queries to eliminate SQL injection vulnerabilities in member-facing systems",
      "Designed Neo4j graph database modeling complex many-to-many relationships across 1,800+ employers, creating navigable knowledge base of union organizational structure"
    ]
  }
];

const skills: Record<string, string[]> = {
  "languages":       ["Python", "SQL", "JavaScript (Node.js)", "Shell"],
  "databases":       ["PostgreSQL", "Redis", "MongoDB", "Neo4j"],
  "cloud & infra":   ["AWS (EC2, S3)", "Docker"],
  "orchestration":   ["Airflow", "Dagster", "CI/CD"],
  "visualization":   ["QuickSight", "SplashBI", "Grafana"],
  "data & ml":       ["Pandas", "NumPy", "scikit-learn", "PyTorch"],
};

const certifications = [
  { name: "AWS Certified Data Engineer – Associate", status: "expected august 2026" },
  { name: "AWS Certified Cloud Practitioner",        status: "april 2026" },
];
---

<Layout title="cv · hayden brown">
  <main class="min-h-screen px-6 py-16 font-mono">
    <div class="w-full max-w-2xl mx-auto">

      <a href="/" class="text-xs text-zinc-400 hover:text-zinc-600 transition-colors mb-12 block">← back</a>

      <!-- Identity -->
      <div class="mb-12">
        <h1 class="text-xl text-zinc-900 mb-1">hayden brown</h1>
        <p class="text-base text-zinc-500 mb-4">data engineer · ny</p>
        <p class="text-sm text-zinc-500 leading-relaxed mb-4 max-w-xl">
          {yearsExperience}+ years experience building data infrastructure and pipelines.
          I make reliable systems so we can get to the fun stuff. <span class="text-xl leading-none">☺︎</span>
          <br>Currently @ NY's largest labor union; OMSCS student @ Georgia Tech
        </p>
        <div class="flex flex-wrap gap-6 text-xs text-zinc-400">
          <a href="&#109;&#97;&#105;&#108;to&#58;me&#64;hay%64&#101;nbr&#37;6Fw&#37;6E&#46;dev" class="hover:text-zinc-600 transition-colors">me@haydenbrown.dev</a>
          <a href="https://linkedin.com/in/hayden-t-brown" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-600 transition-colors">linkedin</a>
          <a href="https://github.com/hb-robo" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-600 transition-colors">github</a>
        </div>
      </div>

      <!-- Experience -->
      <section class="mb-12 border-t border-zinc-200 pt-8">
        <p class="text-xs uppercase tracking-widest text-zinc-400 mb-6">experience</p>
        <div class="space-y-8">
          {experience.map((job) => (
            <div>
              <div class="mb-3">
                <p class="text-sm text-zinc-900">{job.title}</p>
                <p class="text-xs text-zinc-400 mt-0.5">{job.org} · {job.period} · {job.location}</p>
              </div>
              <ul class="space-y-2">
                {job.highlights.map((highlight) => (
                  <li class="text-sm text-zinc-500 leading-relaxed flex gap-3">
                    <span class="text-zinc-300 shrink-0">·</span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Skills -->
      <section class="mb-12 border-t border-zinc-200 pt-8">
        <p class="text-xs uppercase tracking-widest text-zinc-400 mb-6">skills</p>
        <div class="space-y-3">
          {Object.entries(skills).map(([category, items]) => (
            <div class="flex gap-4 items-baseline">
              <span class="text-xs text-zinc-400 w-28 shrink-0">{category}</span>
              <div class="flex flex-wrap gap-1.5">
                {items.map((skill) => (
                  <span class="text-xs text-zinc-600 border border-zinc-200 px-2 py-0.5">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="mb-12 border-t border-zinc-200 pt-8">
        <p class="text-xs uppercase tracking-widest text-zinc-400 mb-6">education</p>
        <div class="space-y-4">
          <div>
            <p class="text-sm text-zinc-900">georgia institute of technology</p>
            <p class="text-xs text-zinc-400 mt-0.5">m.s. computer science (computing systems) · expected may 2028</p>
          </div>
          <div>
            <p class="text-sm text-zinc-900">binghamton university</p>
            <p class="text-xs text-zinc-400 mt-0.5">b.s. computer science · b.a. mathematical sciences · may 2020</p>
          </div>
        </div>
      </section>

      <!-- Certifications -->
      <section class="mb-12 border-t border-zinc-200 pt-8">
        <p class="text-xs uppercase tracking-widest text-zinc-400 mb-6">certifications</p>
        <div class="space-y-4">
          {certifications.map((cert) => (
            <div>
              <p class="text-sm text-zinc-900">{cert.name}</p>
              <p class="text-xs text-zinc-400 mt-0.5">{cert.status}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Projects -->
      <section class="border-t border-zinc-200 pt-8">
        <p class="text-xs uppercase tracking-widest text-zinc-400 mb-6">projects</p>
        <ProjectFilter client:load projects={sortedProjects} />
      </section>

    </div>
  </main>
  <Footer />
</Layout>
