---
import Layout from "../layouts/Layout.astro";
---

<Layout title="hayden brown">
  <main class="min-h-screen flex items-center justify-center px-6 py-16 font-mono">
    <div class="w-full max-w-xl">

      <div class="mb-10">
        <h1 class="text-xl text-zinc-900 mb-1">
          hayden brown
        </h1>
        <p class="text-base text-zinc-500">
          data engineer · albany, ny
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">

        <a
          href="/cv"
          class="group block border border-zinc-200 rounded-lg p-4 hover:border-zinc-400 transition-colors duration-150 bg-amber-50"
        >
          <p class="text-xs uppercase tracking-widest text-zinc-400 mb-3">
            work
          </p>
          <p class="text-base font-medium text-zinc-900 mb-1.5">
            cv
          </p>
          <p class="text-sm text-zinc-500 leading-relaxed">
            experience, skills, education
          </p>
          <p class="text-xs text-zinc-400 mt-4 flex items-center gap-1">
            <span>/cv</span>
            <span class="group-hover:translate-x-0.5 transition-transform duration-150">→</span>
          </p>
        </a>

        <div class="block border border-zinc-200 rounded-lg p-4 bg-emerald-50 opacity-60 cursor-not-allowed">
          <div class="flex items-center justify-between mb-3">
            <p class="text-xs uppercase tracking-widest text-zinc-400">
              data
            </p>
            <span class="text-xs font-mono text-amber-600 border border-amber-300 bg-amber-50 px-1.5 py-0.5 rounded">in progress</span>
          </div>
          <p class="text-base font-medium text-zinc-900 mb-1.5">
            hb-db
          </p>
          <p class="text-sm text-zinc-500 leading-relaxed">
            live personal dashboard
          </p>
          <p class="text-xs text-zinc-400 mt-4">
            <span>/data</span>
          </p>
        </div>

        <div class="block border border-zinc-200 rounded-lg p-4 bg-sky-50 opacity-60 cursor-not-allowed">
          <div class="flex items-center justify-between mb-3">
            <p class="text-xs uppercase tracking-widest text-zinc-400">
              writing
            </p>
            <span class="text-xs font-mono text-amber-600 border border-amber-300 bg-amber-50 px-1.5 py-0.5 rounded">in progress</span>
          </div>
          <p class="text-base font-medium text-zinc-900 mb-1.5">
            the shelf
          </p>
          <p class="text-sm text-zinc-500 leading-relaxed">
            art criticism for physical media
          </p>
          <p class="text-xs text-zinc-400 mt-4">
            <span>theshelf.blog</span>
          </p>
        </div>

      </div>
    </div>
  </main>
</Layout>
