---
import Layout from "../layouts/Layout.astro";
---

<Layout title="hayden brown">
  <main class="min-h-screen flex items-center justify-center px-6 py-16 font-mono">
    <div class="w-full max-w-xl">

      <div class="mb-10">
        <h1 class="text-lg font-xl text-zinc-900 dark:text-zinc-100 mb-1">
          hayden brown
        </h1>
        <p class="text-base text-zinc-500 dark:text-zinc-400">
          data engineer · albany, ny
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">

        <a
          href="/cv"
          class="group block border border-zinc-200 dark:border-zinc-800 rounded-lg p-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors duration-150 bg-amber-50"
        >
          <p class="text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-3">
            work
          </p>
          <p class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-1.5">
            cv
          </p>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
            experience, skills, education
          </p>
          <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-4 flex items-center gap-1">
            <span>/cv</span>
            <span class="group-hover:translate-x-0.5 transition-transform duration-150">→</span>
          </p>
        </a>

        <a
          href="/data"
          class="group block border border-zinc-200 dark:border-zinc-800 rounded-lg p-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors duration-150 bg-emerald-50"
        >
          <p class="text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-3">
            data
          </p>
          <p class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-1.5">
            hb-db
          </p>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
            live personal dashboard
          </p>
          <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-4 flex items-center gap-1">
            <span>/data</span>
            <span class="group-hover:translate-x-0.5 transition-transform duration-150">→</span>
          </p>
        </a>

        <a
          href="https://theshelf.blog"
          target="_blank"
          rel="noopener noreferrer"
          class="group block border border-zinc-200 dark:border-zinc-800 rounded-lg p-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors duration-150 bg-sky-50"
        >
          <p class="text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-3">
            writing
          </p>
          <p class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-1.5">
            the shelf
          </p>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
            art criticism for physical media
          </p>
          <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-4 flex items-center gap-1">
            <span>theshelf.blog</span>
            <span class="group-hover:translate-x-0.5 transition-transform duration-150">↗</span>
          </p>
        </a>

      </div>
    </div>
  </main>
</Layout>
